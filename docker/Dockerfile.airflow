FROM apache/airflow:3.3.1-python3.12

# mlflow-skinny = tracking client only (keeps Airflow's own dependency pins intact)
USER airflow
RUN pip install --no-cache-dir \
      "numpy>=1.26" "pandas>=2.1" "scikit-learn>=1.4" "pyarrow>=14" "joblib>=1.3" \
      "mlflow-skinny>=2.12" "psycopg2-binary>=2.9"
