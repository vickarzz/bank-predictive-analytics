table Corridor
	lineageTag: bc4accb9-0a1f-54e0-8838-a4c5d51afc8f

	column Corridor
		dataType: string
		isKey
		lineageTag: bc2d9b46-c2cf-567f-be04-cdf167506644
		summarizeBy: none
		sourceColumn: Corridor

		annotation SummarizationSetBy = Automatic

	column Currency
		dataType: string
		lineageTag: 9303e00e-4660-58fa-add9-7742be63269d
		summarizeBy: none
		sourceColumn: Currency

