	partition Customer = m
		mode: import
		source =
				let
				    Source =
				        if SourceType = "PostgreSQL" then
				            PostgreSQL.Database(PgServer, PgDatabase){[Schema = "gold", Item = "dim_customer"]}[Data]
				        else if SourceType = "Databricks" then
				            Databricks.Catalogs(DbxServerHostname, DbxHttpPath, [Catalog = null, Database = null, EnableAutomaticProxyDiscovery = null])
				                {[Name = DbxCatalog, Kind = "Database"]}[Data]
				                {[Name = DbxSchema, Kind = "Schema"]}[Data]
				                {[Name = "dim_customer", Kind = "Table"]}[Data]
				        else
				            Table.TransformColumns(
				                Table.PromoteHeaders(
				                    Csv.Document(File.Contents(CsvFolder & "dim_customer.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				                    [PromoteAllScalars = true]),
				                {}, each if _ = "" then null else _),
				    Selected = Table.SelectColumns(Source, {"customer_id", "segment", "region", "customer_type", "age", "age_band", "has_salary_transfer", "product_count", "has_mobile_app", "status", "closed_month", "tenure_months"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"customer_id", Int64.Type}, {"segment", type text}, {"region", type text}, {"customer_type", type text}, {"age", Int64.Type}, {"age_band", type text}, {"has_salary_transfer", type logical}, {"product_count", Int64.Type}, {"has_mobile_app", type logical}, {"status", type text}, {"closed_month", type date}, {"tenure_months", Int64.Type}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"customer_id", "Customer ID"}, {"segment", "Segment"}, {"region", "Region"}, {"customer_type", "Customer Type"}, {"age", "Age"}, {"age_band", "Age Band"}, {"has_salary_transfer", "Has Salary Transfer"}, {"product_count", "Product Count"}, {"has_mobile_app", "Has Mobile App"}, {"status", "Status"}, {"closed_month", "Closed Month"}, {"tenure_months", "Tenure Months"}})
				in
				    Renamed

	annotation PBI_ResultType = Table
