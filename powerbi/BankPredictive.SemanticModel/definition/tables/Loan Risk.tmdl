/// 12-month PD, risk grade and expected loss per live personal-finance contract.
table 'Loan Risk'
	lineageTag: a4dd9c19-6fbe-5043-94ba-b9d5f79da6a7

	measure 'Live Loans' = COUNTROWS('Loan Risk')
		formatString: #,0
		displayFolder: Credit
		lineageTag: f61fc9aa-8044-53ef-947b-3207889c4882

	/// Exposure at default = outstanding balance.
	measure 'EAD (SAR)' = SUM('Loan Risk'[EAD SAR])
		formatString: #,0
		displayFolder: Credit
		lineageTag: 417cd52e-61b5-5711-ae84-c484b3106ebf

	/// PD x LGD x EAD.
	measure 'Expected Loss (SAR)' = SUM('Loan Risk'[Expected Loss SAR])
		formatString: #,0
		displayFolder: Credit
		lineageTag: 99928130-e27c-5148-b711-a2922308f1ae

	measure 'EL Rate' = DIVIDE([Expected Loss (SAR)], [EAD (SAR)])
		formatString: 0.00%
		displayFolder: Credit
		lineageTag: d7f54fbf-d0ab-5ebe-9482-933e5a7bfb08

	measure 'Avg PD' = AVERAGE('Loan Risk'[PD 12M])
		formatString: 0.00%
		displayFolder: Credit
		lineageTag: 5dbec13d-17e0-5b2f-a247-b49ca70f14c3

	measure 'EAD-Weighted PD' = DIVIDE(SUMX('Loan Risk', 'Loan Risk'[PD 12M] * 'Loan Risk'[EAD SAR]), [EAD (SAR)])
		formatString: 0.00%
		displayFolder: Credit
		lineageTag: 1053d620-7272-5d9c-b8fe-b413468d527b

	measure 'Loans Above 45% DBR' = CALCULATE([Live Loans], 'Loan Risk'[DBR] > 0.45)
		formatString: #,0
		displayFolder: Credit
		lineageTag: b0d192b1-56a7-5be6-b175-8a660c7b7c2f

	/// Uses the inactive Origination Date relationship.
	measure 'Loans Originated' = CALCULATE(COUNTROWS('Loan Risk'), USERELATIONSHIP('Loan Risk'[Origination Date], 'Date'[Date]))
		formatString: #,0
		displayFolder: Credit
		lineageTag: a3ef1cf1-c8c2-589b-92f4-c961df782675

	column 'Loan ID'
		dataType: int64
		formatString: 0
		lineageTag: 1cade5cc-a37d-5a79-b9bb-6803cdb47288
		summarizeBy: none
		sourceColumn: Loan ID

		annotation SummarizationSetBy = Automatic

	column 'Customer ID'
		dataType: int64
		formatString: 0
		isHidden
		lineageTag: 8ce500d3-5442-551f-89cf-ec527e6702f1
		summarizeBy: none
		sourceColumn: Customer ID

		annotation SummarizationSetBy = Automatic

	column 'Score Date'
		dataType: dateTime
		formatString: yyyy-mm-dd
