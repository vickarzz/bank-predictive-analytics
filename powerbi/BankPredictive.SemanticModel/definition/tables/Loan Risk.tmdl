	partition 'Loan Risk' = m
		mode: import
		source =
				let
				    Source =
				        if SourceType = "PostgreSQL" then
				            PostgreSQL.Database(PgServer, PgDatabase){[Schema = "gold", Item = "fact_loan_risk"]}[Data]
				        else if SourceType = "Databricks" then
				            Databricks.Catalogs(DbxServerHostname, DbxHttpPath, [Catalog = null, Database = null, EnableAutomaticProxyDiscovery = null])
				                {[Name = DbxCatalog, Kind = "Database"]}[Data]
				                {[Name = DbxSchema, Kind = "Schema"]}[Data]
				                {[Name = "fact_loan_risk", Kind = "Table"]}[Data]
				        else
				            Table.TransformColumns(
				                Table.PromoteHeaders(
				                    Csv.Document(File.Contents(CsvFolder & "fact_loan_risk.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				                    [PromoteAllScalars = true]),
				                {}, each if _ = "" then null else _),
				    Selected = Table.SelectColumns(Source, {"loan_id", "customer_id", "score_date", "product", "origination_date", "principal_sar", "outstanding_sar", "tenor_months", "profit_rate", "monthly_salary_sar", "dbr", "dbr_band", "employer_sector", "bureau_score", "prior_delinquencies", "pd_12m", "risk_grade", "lgd", "ead_sar", "expected_loss_sar", "actual_default_12m", "model_type", "model_version"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"loan_id", Int64.Type}, {"customer_id", Int64.Type}, {"score_date", type date}, {"product", type text}, {"origination_date", type date}, {"principal_sar", type number}, {"outstanding_sar", type number}, {"tenor_months", Int64.Type}, {"profit_rate", type number}, {"monthly_salary_sar", type number}, {"dbr", type number}, {"dbr_band", type text}, {"employer_sector", type text}, {"bureau_score", Int64.Type}, {"prior_delinquencies", Int64.Type}, {"pd_12m", type number}, {"risk_grade", type text}, {"lgd", type number}, {"ead_sar", type number}, {"expected_loss_sar", type number}, {"actual_default_12m", type number}, {"model_type", type text}, {"model_version", type text}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"loan_id", "Loan ID"}, {"customer_id", "Customer ID"}, {"score_date", "Score Date"}, {"product", "Product"}, {"origination_date", "Origination Date"}, {"principal_sar", "Principal SAR"}, {"outstanding_sar", "Outstanding SAR"}, {"tenor_months", "Tenor Months"}, {"profit_rate", "Profit Rate"}, {"monthly_salary_sar", "Monthly Salary SAR"}, {"dbr", "DBR"}, {"dbr_band", "DBR Band"}, {"employer_sector", "Employer Sector"}, {"bureau_score", "Bureau Score"}, {"prior_delinquencies", "Prior Delinquencies"}, {"pd_12m", "PD 12M"}, {"risk_grade", "Risk Grade"}, {"lgd", "LGD"}, {"ead_sar", "EAD SAR"}, {"expected_loss_sar", "Expected Loss SAR"}, {"actual_default_12m", "Actual Default 12M"}, {"model_type", "Model Type"}, {"model_version", "Model Version"}})
				in
				    Renamed

	annotation PBI_ResultType = Table
