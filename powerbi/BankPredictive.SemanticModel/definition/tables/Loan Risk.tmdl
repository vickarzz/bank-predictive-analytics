		summarizeBy: none
		sourceColumn: Tenor Months

		annotation SummarizationSetBy = Automatic

	column 'Profit Rate'
		dataType: double
		formatString: 0.00%
		lineageTag: 2d3d4f6f-3348-5303-96e9-8cadaa4c0be3
		summarizeBy: none
		sourceColumn: Profit Rate

		annotation SummarizationSetBy = Automatic

	column 'Monthly Salary SAR'
