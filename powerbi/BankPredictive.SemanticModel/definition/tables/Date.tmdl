	column 'Is Forecast Period'
		dataType: boolean
		lineageTag: dbb175af-fd97-5dc4-afe4-ef9dbbc2c2af
		summarizeBy: none
		sourceColumn: Is Forecast Period

		annotation SummarizationSetBy = Automatic

	partition Date = m
		mode: import
		source =
				let
				    Source =
				        if SourceType = "PostgreSQL" then
				            PostgreSQL.Database(PgServer, PgDatabase){[Schema = "gold", Item = "dim_date"]}[Data]
				        else if SourceType = "Databricks" then
				            Databricks.Catalogs(DbxServerHostname, DbxHttpPath, [Catalog = null, Database = null, EnableAutomaticProxyDiscovery = null])
				                {[Name = DbxCatalog, Kind = "Database"]}[Data]
				                {[Name = DbxSchema, Kind = "Schema"]}[Data]
				                {[Name = "dim_date", Kind = "Table"]}[Data]
				        else
				            Table.TransformColumns(
				                Table.PromoteHeaders(
				                    Csv.Document(File.Contents(CsvFolder & "dim_date.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				                    [PromoteAllScalars = true]),
				                {}, each if _ = "" then null else _),
				    Selected = Table.SelectColumns(Source, {"date", "year", "quarter", "month_num", "month_name", "year_month", "month_end", "day_of_week", "day_of_week_num", "is_weekend", "is_forecast_period"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"date", type date}, {"year", Int64.Type}, {"quarter", type text}, {"month_num", Int64.Type}, {"month_name", type text}, {"year_month", type text}, {"month_end", type date}, {"day_of_week", type text}, {"day_of_week_num", Int64.Type}, {"is_weekend", type logical}, {"is_forecast_period", type logical}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"date", "Date"}, {"year", "Year"}, {"quarter", "Quarter"}, {"month_num", "Month Num"}, {"month_name", "Month"}, {"year_month", "Year Month"}, {"month_end", "Month End"}, {"day_of_week", "Day of Week"}, {"day_of_week_num", "Day of Week Num"}, {"is_weekend", "Is Weekend"}, {"is_forecast_period", "Is Forecast Period"}})
				in
				    Renamed

	annotation PBI_ResultType = Table
