/// Where to read the gold tables from
expression SourceType = "CSV" meta [IsParameterQuery = true, List = {"CSV", "PostgreSQL", "Databricks"}, DefaultValue = "CSV", Type = "Text", IsParameterQueryRequired = true]
	lineageTag: 33f1c7b3-174b-582e-8004-d67bb0f07246

	annotation PBI_ResultType = Text

/// Folder with gold CSV files (end with a backslash)
